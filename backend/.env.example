GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
PORT=5000
TARGET_FRONTEND=target-frontend
TARGET_BACKEND=target-backend
TARGET_DATABASE=target-db
BACKEND_HEALTH_URL=http://target-backend:3000/health
FRONTEND_URL=http://localhost:8080
LATENCY_THRESHOLD_MS=1000
SANDBOX_PREFIX=sandbox-

# Docker and service configuration
DOCKER_SOCKET=/var/run/docker.sock
NEXUS_CONTAINER=nexus-backend
TARGET_BACKEND_PORT=3000
FRONTEND_HEALTH_URL=http://target-frontend
DB_HOST=target-db
DB_PORT=5432
DB_NAME=nexus_target
DB_USER=nexus
DB_PASSWORD=nexus_secret
HEALTH_CHECK_INTERVAL_MS=5000
HEALTH_TIMEOUT_MS=3000
VALIDATION_LATENCY_THRESHOLD_MS=1000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
NEXUS_API_URL=http://localhost:5000/api
